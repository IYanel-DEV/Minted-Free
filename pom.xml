<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.minted</groupId>
    <artifactId>minted-free</artifactId>
    <version>0.65.0</version>
    <packaging>jar</packaging>

    <name>Minted-Free</name>
    <description>GUI-first economy plugin for premium survival and roleplay servers.</description>
    <url>https://github.com/IYanel-DEV/Minted-Free</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype-ossrh</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
        </repository>
        <!-- VaultAPI: the economy interface other plugins talk to. Provided only. -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>extendedclip-repo</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <!--
            VaultUnlockedAPI (the vault2 economy API behind VaultUnlocked).
            Provided only, like Vault below: the host server supplies it at
            runtime, every reference is class-presence-guarded, and the jar
            never contains a copy of either API.
        -->
        <repository>
            <id>codemc-creatorfromhell</id>
            <url>https://repo.codemc.io/repository/creatorfromhell/</url>
        </repository>
        <!-- ProtocolLib 5.x: the wire library behind the self-built bank tellers. -->
        <repository>
            <id>dmulloy2-repo</id>
            <url>https://repo.dmulloy2.net/repository/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
            Compiling against the oldest supported server API (1.8.8) guarantees
            every class we reference exists at runtime on 1.8 through 1.26.
            Anything version-specific goes through the compat layer instead.
        -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Last HikariCP release on the Java-7 compatible line. Bundled and
            relocated (see the shade plugin) so it never clashes with a copy the
            host server or another plugin already ships.
        -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>2.7.9</version>
        </dependency>

        <!--
            HikariCP logs through slf4j-api; without a binding slf4j shouts its
            "Failed to load StaticLoggerBinder" to stderr on every boot. slf4j-nop
            ships the NOP binder so the pool logs into the void - bundled and
            relocated to dev.minted.libs.slf4j like the API itself, so it never
            fights a binding another plugin brings.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>1.7.30</version>
        </dependency>

        <!--
            sqlite-jdbc is bundled because the server classpath has no driver
            for the default sqlite setup (or any driver, on modern Paper). Its
            native libraries are pruned to Spigot's actual host platforms in the
            shade plugin so the fat jar stays small enough for resource upload.
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.28.0</version>
        </dependency>

        <!--
            MariaDB Connector/J speaks plain "jdbc:mysql://" and supports both
            MySQL 8 (incl. caching_sha2_password auth) and MariaDB servers,
            while being a fraction of the upstream mysql-connector-j size and
            needing no protobuf. Bundled and relocated to dev.minted.libs.mysql
            like the old driver, so the 1.8 -> 1.26 promise stays intact.
        -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>2.7.12</version>
        </dependency>

        <!--
            bStats metrics (plugin id 34228). Unlike the plugin APIs below,
            bStats is a metrics client library, not a server plugin, so it
            must be bundled - relocated into dev.minted.libs.bstats so a
            second plugin shipping its own copy never collides. It is silent,
            opt-out for server owners (plugins/<DataFolder>/bStats/config.yml)
            and never blocks startup on failure.
        -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
        </dependency>

        <!--
            Optional integration APIs. Every one is `provided`: the host server
            supplies it at runtime and the hooks are guarded, so the jar never
            contains a competing copy and never breaks when the plugin is
            absent.
        -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            VaultUnlockedAPI: the vault2 economy API served by the VaultUnlocked
            plugin (https://github.com/TheNewEconomy/VaultUnlockedAPI). Its jar
            also carries the classic net.milkbowl.vault API, which is why a
            VaultUnlocked-only server still speaks old Vault - but Minted keeps
            the two hooks separate so either side can be absent. Provided only,
            never shaded.
        -->
        <dependency>
            <groupId>net.milkbowl.vault</groupId>
            <artifactId>VaultUnlockedAPI</artifactId>
            <version>2.20</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!--
            ProtocolLib 5.3.0 drives the self-built bank tellers. Provided and
            never shaded: the host server supplies it at runtime and the whole
            feature is guarded, so Minted degrades cleanly when it is absent.
            The modern player-list structures it exposes on 1.19.3+ are the
            only reason this is not the 4.8 line.
        -->
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.3.0</version>
            <scope>provided</scope>
        </dependency>
        <!--
            WrappedGameProfile#getProperties returns guava's Multimap, so javac
            needs guava on the compile classpath. Bukkit ships guava on every
            supported server, hence provided; it is never bundled.
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>21.0</version>
            <scope>provided</scope>
        </dependency>
        <!--
            JUnit 5 for the self-test suite (test scope only, never shipped).
            The checks live in the plugin itself - see dev.minted.selftest - so
            `mvn test` runs exactly the same catalogue as /minted selftest.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>Minted-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>8</release>
                </configuration>
            </plugin>
            <!--
                Runs the self-test suite during `mvn test`, and therefore also
                during every `mvn package`. The default surefire bundled with
                Maven predates JUnit 5, so the version is pinned here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>dev.minted.libs.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>dev.minted.libs.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.mariadb</pattern>
                                    <shadedPattern>dev.minted.libs.mysql</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>dev.minted.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <!--
                                The sqlite driver is deliberately NOT relocated: its native
                                library (JNI) hard-codes org.sqlite.core.*, so "org.sqlite"
                                has to keep its name. The plugin classloader is child-first,
                                so our bundled copy shadows anything the host server ships.
                            -->
                            <filters>
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <!--
                                            Natives for the platforms Spigot/Paper actually run on
                                            would make a fat jar too big for resource upload. Only
                                            Linux x86_64 / aarch64 and Windows x86_64 stay; the
                                            rest are dead weight on a Minecraft server.
                                        -->
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Mac/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/android-arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                        <exclude>org/sqlite/native/Linux/x86/**</exclude>
                                        <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                        <exclude>org/sqlite/native/Windows/x86/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
